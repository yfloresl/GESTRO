# Plantilla SIN valores. Copie este archivo a keystore.properties (ignorado por git) o, mejor, a ~/.kyros-android/keystore.properties
# (fuera del repositorio) y complete SOLO en su equipo. NUNCA suba la llave (.jks/.keystore) ni sus contraseñas a git, chat o correo.
# Alternativa sin archivo: variables de entorno KYROS_KEYSTORE_FILE, KYROS_KEYSTORE_PASSWORD, KYROS_KEY_ALIAS, KYROS_KEY_PASSWORD.
storeFile=
storePassword=
keyAlias=
keyPassword=
