<?xml version="1.0" encoding="utf-8"?>
<!-- Solo https: sin tráfico en claro y sin certificados de usuario. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
